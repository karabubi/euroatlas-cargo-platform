# ============================================================
# EuroAtlas Cargo Platform
# Example environment configuration
# ============================================================

# PostgreSQL
POSTGRES_USER=euroatlas
POSTGRES_PASSWORD=change_me
POSTGRES_DB=euroatlas_cargo

DATABASE_URL=postgresql://euroatlas:change_me@localhost:55432/euroatlas_cargo?schema=public

# API
PORT=4000
JWT_SECRET=replace_with_a_long_secure_random_secret

# One or more comma-separated browser origins.
CORS_ORIGIN=http://localhost:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ============================================================
# Customer tracking notifications
# ============================================================

# Public URL used in email / WhatsApp tracking links
PUBLIC_TRACKING_URL=http://localhost:3000/track

# SMTP email
EMAIL_FROM=

# WhatsApp Cloud API
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TRACKING_TEMPLATE=shipment_tracking_update
WHATSAPP_TEMPLATE_LANGUAGE=en

# ------------------------------------------------------------
# Email delivery - Resend HTTPS API
# ------------------------------------------------------------
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=
