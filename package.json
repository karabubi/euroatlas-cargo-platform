{
  "name": "euroatlas-cargo-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api start:dev",
    "dev": "pnpm --parallel --filter web --filter api dev",
    "test": "pnpm --dir apps/api run test:all",
    "test:api": "pnpm --dir apps/api run test:unit",
    "test:api:e2e": "pnpm --dir apps/api run test:e2e",
    "test:api:db": "pnpm --dir apps/api run test:db",
    "verify:api": "pnpm --dir apps/api run verify",
    "verify:web": "pnpm --dir apps/web run verify",
    "verify": "pnpm run verify:api && pnpm run verify:web",
    "release:check": "bash deploy/scripts/release-check.sh",
    "production:preflight": "bash deploy/scripts/production-preflight.sh",
    "release:manifest": "bash deploy/scripts/generate-release-manifest.sh",
    "release:tag:check": "bash deploy/scripts/validate-release-tag.sh",
    "release:bundle": "bash deploy/scripts/create-release-bundle.sh",
    "server:preflight": "bash deploy/scripts/server-preflight.sh",
    "server:env:check": "bash deploy/scripts/validate-production-env.sh",
    "server:deploy:first": "bash deploy/scripts/first-deploy.sh",
    "server:state:capture": "bash deploy/scripts/capture-deployment-state.sh"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "20.19.x",
    "pnpm": "10.34.x"
  }
}
