{
  "name": "euroatlas-cargo-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api start:dev",
    "dev": "pnpm --parallel --filter web --filter api dev",
    "test": "pnpm --dir apps/api run test:all",
    "test:api": "pnpm --dir apps/api run test:unit",
    "test:api:e2e": "pnpm --dir apps/api run test:e2e",
    "test:api:db": "pnpm --dir apps/api run test:db",
    "verify:api": "pnpm --dir apps/api run verify"
  }
}
