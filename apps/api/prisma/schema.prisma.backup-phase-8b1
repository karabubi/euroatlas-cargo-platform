generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  EMPLOYEE
  CUSTOMER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  firstName String
  lastName  String
  password  String
  role      UserRole @default(CUSTOMER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Customer {
  id          String     @id @default(uuid())
  customerNo  String     @unique
  companyName String?
  firstName   String
  lastName    String
  email       String?    @unique
  phone       String?
  mobile      String?
  address     String?
  postalCode  String?
  city        String?
  country     String?
  taxNumber   String?
  notes       String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  shipments   Shipment[]

  @@index([lastName])
  @@index([companyName])
  @@index([customerNo])
}

enum VehicleStatus {
  REGISTERED
  RECEIVED
  INSPECTED
  READY_FOR_LOADING
  LOADED
  IN_TRANSIT
  ARRIVED
  CUSTOMS_CLEARANCE
  READY_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum ShipmentStatus {
  DRAFT
  QUOTED
  BOOKED
  RECEIVED
  LOADED
  IN_TRANSIT
  ARRIVED
  CUSTOMS_CLEARANCE
  READY_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum TrackingEventType {
  CREATED
  STATUS_CHANGED
  LOCATION_UPDATE
  DOCUMENT_UPLOADED
  NOTE_ADDED
}

model Shipment {
  id         String   @id @default(uuid())
  shipmentNo String   @unique
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  status             ShipmentStatus @default(DRAFT)
  originCountry      String
  originCity         String?
  originPort         String?
  destinationCountry String
  destinationCity    String?
  destinationPort    String?

  bookingReference String?
  containerNumber  String?
  shippingLine     String?
  vesselName       String?
  voyageNumber     String?

  estimatedDeparture DateTime?
  actualDeparture    DateTime?
  estimatedArrival   DateTime?
  actualArrival      DateTime?

  description String?
  notes       String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles Vehicle[]

  tracking ShipmentTracking[]

  @@index([customerId])
  @@index([shipmentNo])
  @@index([status])
  @@index([createdAt])
}

model Vehicle {
  id         String   @id @default(uuid())
  vehicleNo  String   @unique
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  vin          String? @unique
  make         String
  model        String
  year         Int?
  color        String?
  vehicleType  String?
  fuelType     String?
  transmission String?

  purchasePrice Decimal? @db.Decimal(12, 2)
  declaredValue Decimal? @db.Decimal(12, 2)

  hasKeys           Boolean @default(true)
  isRunning         Boolean @default(true)
  hasDamage         Boolean @default(false)
  damageDescription String?

  status   VehicleStatus @default(REGISTERED)
  notes    String?
  isActive Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shipmentId])
  @@index([vehicleNo])
  @@index([vin])
  @@index([make])
  @@index([model])
  @@index([status])
  @@index([createdAt])
}


model ShipmentTracking {
  id String @id @default(uuid())

  shipmentId String
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  eventType TrackingEventType

  status ShipmentStatus?

  title String

  description String?

  location String?

  createdBy String?

  createdAt DateTime @default(now())

  @@index([shipmentId])
  @@index([eventType])
  @@index([createdAt])
}
