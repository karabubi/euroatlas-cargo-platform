# ============================================================
# EuroAtlas Cargo
# Linux Server Deployment Configuration
# ============================================================

# Application
APP_NAME=euroatlas-cargo
APP_DIR=/opt/euroatlas-cargo

# GitHub repository
GIT_REPOSITORY=https://github.com/karabubi/euroatlas-cargo-platform.git
RELEASE_TAG=v1.0.0

# Public domain
DOMAIN=cargo.example.com
ACME_EMAIL=admin@example.com

# Server deployment user
DEPLOY_USER=euroatlas

# Persistent backup location
BACKUP_DIR=/var/backups/euroatlas-cargo

# Required public ports
HTTP_PORT=80
HTTPS_PORT=443

# Docker
DOCKER_REQUIRED=true

# Recommended minimum resources
MIN_DISK_GB=10
MIN_MEMORY_MB=2048
