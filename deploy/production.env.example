# ============================================================
# EuroAtlas Cargo Platform
# Production Compose environment example
# ============================================================

# PostgreSQL
POSTGRES_USER=euroatlas
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_DB=euroatlas_cargo

# API
API_PORT=4000
JWT_SECRET=replace_with_a_long_secure_random_secret
CORS_ORIGIN=http://localhost:3000

# Web
WEB_PORT=3000

# This value is embedded into the Next.js browser build.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Reverse proxy / TLS
DOMAIN=cargo.example.com
ACME_EMAIL=admin@example.com

# ------------------------------------------------------------
# Email notifications
# ------------------------------------------------------------
PUBLIC_TRACKING_URL=https://euroatlas-cargo-web.vercel.app/track
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=

# ------------------------------------------------------------
# Email delivery - Resend HTTPS API
# ------------------------------------------------------------
RESEND_API_KEY=
